# Copiar como .env y llenar con los valores reales (el .env NO se sube a Git)
SECRET_KEY=cambiar-esta-clave
FLASK_DEBUG=1

# Modo del lector de huella: secugen (lector real) o simulado (para la Mac)
HUELLA_MODO=simulado
HUELLA_UMBRAL=45
SECUGEN_URL=https://localhost:8000

# Correo (Flask-Mail). Mientras esto no se llene, los correos quedan simulados.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=GolStats <no-reply@golstats.com>

# PostgreSQL (se usa recien en la ultima etapa)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/golstats
