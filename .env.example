# Copiar como .env y llenar con los valores reales (el .env NO se sube a Git)
SECRET_KEY=cambiar-esta-clave
FLASK_DEBUG=1

# ── Lector de huella SecuGen ──────────────────────────────────────
# secugen  → Flask captura directo del lector (solo en la laptop que
#            tiene el lector fisico conectado).
# simulado → no toca hardware; es lo que usamos los demas para
#            desarrollar sin lector.
HUELLA_MODO=simulado
HUELLA_UMBRAL=45
HUELLA_LECTOR=secugen:hsdu03p

# ── Correo (Flask-Mail) ───────────────────────────────────────────
# Mientras falte MAIL_SERVER, MAIL_USERNAME o MAIL_PASSWORD, los correos
# se simulan: quedan en la bandeja del panel del admin y se imprimen en
# consola. Asi se prueba el flujo completo sin cuenta de correo.
#
# Para Gmail, MAIL_PASSWORD NO es la contrasena de la cuenta: es una
# "contrasena de aplicacion" de 16 caracteres que se genera en
# https://myaccount.google.com/apppasswords y exige tener activada la
# verificacion en dos pasos. Desde 2022 Gmail rechaza la contrasena
# normal por SMTP.
#
# AVISO: esa contrasena va en el .env y en ningun otro sitio. Este
# archivo .env.example SI se sube a GitHub.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=
# Si se deja vacio, se usa MAIL_USERNAME: Gmail ignora cualquier otro
# remitente y los correos con remitente ajeno acaban en spam.
MAIL_DEFAULT_SENDER=

# Dias de antelacion con que se avisa al capitan del partido proximo.
DIAS_AVISO_PARTIDO=3

# ── PostgreSQL ────────────────────────────────────────────────────
# Solo guarda la tabla de huellas (registros_biometricos). Si la clave
# no es la correcta, la app igual levanta: las pantallas que consultan
# huellas muestran "No disponible" en vez de reventar.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/golstats
